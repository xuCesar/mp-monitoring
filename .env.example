SIGNALING_PORT=3000
SIGNALING_ORIGIN=https://monitor.example.com
ROOM_ID=camera-01
MAX_VIEWERS_PER_ROOM=3
CAMERA_DEVICE_TOKEN=replace-me
VIEWER_ACCESS_TOKEN=replace-me
